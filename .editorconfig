root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[*.{json,yml,yaml,md,html,css,ts,js,mjs,toml}]
indent_size = 2

[*.{json,html,css,ts,js,mjs}]
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.wit]
indent_size = 4
