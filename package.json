{
  "name": "deepseek-jungle-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Jungle (Dou Shou Qi) standalone web game and Jungle Arena WebAssembly component.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-identity.mjs && node scripts/gen-theme.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/unit/*.test.mjs tests/parity/*.test.mjs",
    "test:e2e": "playwright test",
    "test:conformance": "node scripts/conformance.mjs",
    "admission": "node scripts/admission.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "strength": "node scripts/strength.mjs",
    "check": "node scripts/sync-identity.mjs --check && node scripts/gen-theme.mjs --check && node scripts/check-rules-digest.mjs && tsc --noEmit"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.42.0",
    "@bytecodealliance/jco-transpile": "0.24.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@bytecodealliance/jco-transpile": "0.24.0"
  }
}
