<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- AOT is mandatory for Release: the interpreter is far too slow for the AI search.
         Requires: dotnet workload install wasm-tools -->
    <RunAOT>true</RunAOT>
    <!-- Real pthread support in the browser so the AI search runs off the UI thread.
         The host must serve COOP/COEP headers (wwwroot/_headers in production,
         e2e/serve.mjs locally) so SharedArrayBuffer is available. -->
    <WasmEnableThreads>true</WasmEnableThreads>
    <!-- Cap the WASM heap for mobile browsers (default 2 GB can be denied by iOS Safari). -->
    <EmccMaximumHeapSize>536870912</EmccMaximumHeapSize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.25" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.25" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reused verbatim from the desktop app: the single C# source of truth for rules and AI. -->
    <ProjectReference Include="..\JungleGame.Core\JungleGame.Core.csproj" />
  </ItemGroup>

</Project>
